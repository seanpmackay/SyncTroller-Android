<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar notification icon: must be a flat white silhouette on a
     transparent background (Android re-tints/masks it itself), so this
     can't just reuse the full-color launcher icon. Same glyph as the
     in-app sync-fab button (a broken ring + center dot), traced from its
     SVG path in index.html/icons.js so the notification reads as the same
     icon at a glance. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,4 a8,8 0 1,0 8,8 h-2 a6,6 0 1,1 -6,-6 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,12 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" />
</vector>
